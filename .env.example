# Optional model providers. Do not commit real secrets.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Usually 1000 inside a Linux/WSL checkout. Set to `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000

# Keep "." when invoking Compose from the repository root.
PROJECT_DIR=.

# Current Lean/Pantograph image is verified for x86-64.
DOCKER_PLATFORM=linux/amd64
